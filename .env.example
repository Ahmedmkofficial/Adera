# ==============================================================================
# Adera Environment Configuration (.env.example)
#
# Copy this file to '.env' to configure your local or container environment:
#   cp .env.example .env
#
# DO NOT commit '.env' containing real secrets to version control.
# ==============================================================================

# PostgreSQL Configuration
# Kali host may already run native PostgreSQL on port 5432.
# In Docker Compose, the host port mapping defaults to 5433 to avoid port collisions,
# while containers communicate internally on db:5432.
POSTGRES_USER=adera_user
POSTGRES_PASSWORD=your_password
POSTGRES_DB=adera_db
POSTGRES_PORT=5433

# Database Connection URL
# For Docker Compose backend, DATABASE_URL is constructed automatically using service name 'db'.
# For host-based local development (e.g. uvicorn or alembic on host), connect to port 5433:
DATABASE_URL=postgresql://adera_user:your_password@localhost:5433/adera_db

# Security & Authentication
# JWT_SECRET_KEY MUST be a cryptographically secure random string (at least 32 bytes).
# Generate one using either:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
#   or:
#   openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
# Comma-separated list of allowed web origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Settings (optional overrides; Docker Compose defaults to VITE_USE_MOCK=false and VITE_API_URL="")
# VITE_USE_MOCK=false
# VITE_API_URL=
